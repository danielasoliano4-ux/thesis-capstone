rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.secure_login == true
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && (!exists(/databases/$(database)/documents/_session_revocations/$(request.auth.uid))
          || request.auth.token.auth_time > get(/databases/$(database)/documents/_session_revocations/$(request.auth.uid)).data.revokedAt);
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() && (userProfile().role == 'admin' || userProfile().role == 'administrator');
    }

    function isClinicStaff() {
      return isLoggedIn() && userProfile().role == 'clinic_staff'
        && userProfile().is_active == true
        && userProfile().get('approval_status', 'approved') == 'approved';
    }

    function isResident() {
      return isLoggedIn() && userProfile().role == 'resident';
    }

    function belongsToClinic(clinicId) {
      return isClinicStaff()
        && (userProfile().clinic_id == clinicId || request.auth.uid == clinicId);
    }

    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email_verification_required == true
        && !request.resource.data.keys().hasAny(['email_verification_source', 'email_verification_migrated_at'])
        && request.resource.data.role in ['resident', 'clinic_staff']
        && ((request.resource.data.role == 'resident'
          && request.resource.data.is_active == true
          && request.resource.data.approval_status == 'approved')
          || (request.resource.data.role == 'clinic_staff'
          && request.resource.data.is_active == false
          && request.resource.data.approval_status == 'pending'
          && request.resource.data.clinic_lat is number
          && request.resource.data.clinic_lng is number
          && request.resource.data.clinic_lat >= 14.10 && request.resource.data.clinic_lat <= 14.35
          && request.resource.data.clinic_lng >= 121.00 && request.resource.data.clinic_lng <= 121.25
          && request.resource.data.bplo_certificate_url is string
          && request.resource.data.bplo_certificate_url.size() > 0));
      allow update: if isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clinic_lat', 'clinic_lng']);
      allow delete: if isAdmin();
    }

    match /residents/{residentId} {
      // Registration may create only its own initial resident profile before verification.
      allow create: if request.auth != null && request.auth.uid == residentId
        && userProfile().role == 'resident' && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isResident() && request.auth.uid == residentId;
      allow read: if isAdmin() || isClinicStaff();
    }

    function validClinicPin() {
      return request.resource.data.lat is number && request.resource.data.lng is number
        && request.resource.data.lat >= 14.10 && request.resource.data.lat <= 14.35
        && request.resource.data.lng >= 121.00 && request.resource.data.lng <= 121.25
        && request.resource.data.location.latitude == request.resource.data.lat
        && request.resource.data.location.longitude == request.resource.data.lng;
    }
    match /clinics/{clinicId} {
      allow read: if true;
      // Stock summaries are derived by server transactions and inventory events.
      allow create: if !request.resource.data.keys().hasAny(['stock_total', 'stock_status', 'stock_summary'])
        && ((isAdmin() && !request.resource.data.keys().hasAny(['lat', 'lng', 'location'])) || (belongsToClinic(clinicId)
        && !request.resource.data.keys().hasAny(['lat', 'lng', 'location', 'geocoding_provider', 'geocoding_accuracy', 'geocoded_at', 'approved_by', 'approval_status'])));
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stock_total', 'stock_status', 'stock_summary'])
        && ((isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lat', 'lng', 'location']))
        || (belongsToClinic(clinicId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['staff_uid', 'geocoding_provider', 'geocoding_accuracy', 'geocoded_at', 'approved_by', 'approval_status'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lat', 'lng', 'location']) || validClinicPin())));
      allow delete: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if isResident() || isAdmin() || belongsToClinic(resource.data.clinic_id);
      allow create: if request.resource.data.quantity is int && request.resource.data.quantity >= 0
        && request.resource.data.get('quantity_mode', '') in ['', 'on_hand']
        && request.resource.data.get('reserved_count', 0) == 0 && (isAdmin() || (belongsToClinic(request.resource.data.clinic_id)
        && request.resource.data.type is string
        && request.resource.data.manufacturer is string
        && request.resource.data.batch is string
        && request.resource.data.quantity is number
        && request.resource.data.expiry is string));
      allow update: if request.resource.data.quantity is int && request.resource.data.quantity >= 0
        && request.resource.data.get('quantity_mode', '') in ['', 'on_hand']
        && request.resource.data.quantity >= request.resource.data.get('reserved_count', 0)
        && (resource.data.get('quantity_mode', '') != 'on_hand' || request.resource.data.get('quantity_mode', '') == 'on_hand')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reserved_count'])
        && (resource.data.get('reserved_count', 0) == 0 || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clinic_id', 'type', 'brand_name', 'generic_name', 'batch', 'expiry', 'archived']))
        && (isAdmin() || (belongsToClinic(resource.data.clinic_id)
        && belongsToClinic(request.resource.data.clinic_id)
        && request.resource.data.type is string
        && request.resource.data.manufacturer is string
        && request.resource.data.batch is string
        && request.resource.data.quantity is number
        && request.resource.data.expiry is string));
      allow delete: if resource.data.get('reserved_count', 0) == 0 && (isAdmin() || belongsToClinic(resource.data.clinic_id));
    }

    match /appointments/{appointmentId} {
      // createBooking performs the atomic duplicate check with the Admin SDK.
      allow create: if false;
      allow read: if isResident()
        && resource.data.resident_uid == request.auth.uid;
      allow read: if isAdmin() || belongsToClinic(resource.data.clinic_id);
      allow update: if isAdmin()
        || (belongsToClinic(resource.data.clinic_id)
          && resource.data.status != 'expired'
          && (resource.data.status != 'pending' || (resource.data.get('scheduled_at_ms', null) != null && request.time.toMillis() < resource.data.scheduled_at_ms))
          && request.resource.data.clinic_id == resource.data.clinic_id
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'vaccination_session_id', 'treatment_id', 'dose_number', 'dose_label', 'recommended_date', 'course_vaccination_history', 'resident_uid', 'preferred_date', 'preferred_time', 'confirmed_at', 'arrived_at', 'arrived_by', 'arrival_deadline_ms', 'scheduled_at_ms',
            'intake_completed_at', 'patient_record_id', 'course_intake_data', 'stock_reservation'
          ])
          && (resource.data.get('intake_completed_at', null) == null
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'bite_type', 'wound_washed', 'animal_type', 'bite_body_part', 'bite_date', 'patient_age', 'patient_sex'
            ]))
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending' && request.resource.data.status == 'declined')
            ));
      // Residents cancel/reschedule through callables so staff notifications
      // and reservation updates are committed with the appointment change.
      allow delete: if false; // Appointment history is retained; use cancellation instead.
    }

    match /patient_records/{recordId} {
      allow read: if isAdmin() || belongsToClinic(resource.data.clinic_id)
        || (isResident() && resource.data.resident_uid == request.auth.uid);
      // Written atomically by manageAppointment. Permanent records are immutable.
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isLoggedIn() && (
          resource.data.get('recipient_uid', '') == request.auth.uid
          || resource.data.get('user_id', '') == request.auth.uid
          || belongsToClinic(resource.data.get('clinic_id', ''))
        ));
      allow create: if request.resource.data.get('push', false) != true
        && (isAdmin()
          || isClinicStaff()
          || (isResident() && request.resource.data.type == 'appointment'));
      allow update: if isLoggedIn()
        && (resource.data.get('recipient_uid', '') == request.auth.uid
          || resource.data.get('user_id', '') == request.auth.uid
          || belongsToClinic(resource.data.get('clinic_id', '')))
        && request.resource.data.read is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    match /resident_push_tokens/{tokenId} {
      allow read, delete: if isResident() && resource.data.resident_uid == request.auth.uid;
      allow create, update: if isResident()
        && request.resource.data.resident_uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096;
    }

    match /history/{historyId} {
      allow read: if isAdmin() || belongsToClinic(resource.data.clinic_id);
      allow create: if isAdmin() || belongsToClinic(request.resource.data.clinic_id);
      allow update, delete: if isAdmin();
    }

    match /vaccination_records/{recordId} {
      allow read: if isAdmin() 
        || (isResident() && resource.data.resident_uid == request.auth.uid)
        || belongsToClinic(resource.data.clinic_id);
      allow create: if false; // Server validates sequence, verification and stock.
      allow update, delete: if false;
    }

    match /treatments/{treatmentId} {
      allow read: if isAdmin() || (isResident() && resource.data.resident_uid == request.auth.uid);
      allow write: if false;
    }
    match /vaccination_documents/{documentId} {
      // Supporting vaccination-history records can be reviewed by administrators;
      // clinic staff receive only the document reference attached to their clinic's appointment.
      allow read: if isAdmin() || (isResident() && resource.data.resident_uid == request.auth.uid);
      allow create: if isResident() && request.resource.data.resident_uid == request.auth.uid;
      allow update, delete: if isResident() && resource.data.resident_uid == request.auth.uid;
    }
  }
}
