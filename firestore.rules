rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.secure_login == true
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && (!exists(/databases/$(database)/documents/_session_revocations/$(request.auth.uid))
          || request.auth.token.auth_time > get(/databases/$(database)/documents/_session_revocations/$(request.auth.uid)).data.revokedAt);
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isLoggedIn() && (userProfile().role == 'admin' || userProfile().role == 'administrator');
    }

    function isClinicStaff() {
      return isLoggedIn() && userProfile().role == 'clinic_staff'
        && userProfile().is_active == true
        && userProfile().get('approval_status', 'approved') == 'approved';
    }

    function isResident() {
      return isLoggedIn() && userProfile().role == 'resident';
    }

    function belongsToClinic(clinicId) {
      return isClinicStaff()
        && (userProfile().clinic_id == clinicId || request.auth.uid == clinicId);
    }

    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email_verification_required == true
        && !request.resource.data.keys().hasAny(['email_verification_source', 'email_verification_migrated_at'])
        && request.resource.data.role in ['resident', 'clinic_staff']
        && ((request.resource.data.role == 'resident'
          && request.resource.data.is_active == true
          && request.resource.data.approval_status == 'approved')
          || (request.resource.data.role == 'clinic_staff'
          && request.resource.data.is_active == false
          && request.resource.data.approval_status == 'pending'
          && request.resource.data.bplo_certificate_url is string
          && request.resource.data.bplo_certificate_url.size() > 0));
      allow update, delete: if isAdmin();
    }

    match /residents/{residentId} {
      // Registration may create only its own initial resident profile before verification.
      allow create: if request.auth != null && request.auth.uid == residentId
        && userProfile().role == 'resident' && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isResident() && request.auth.uid == residentId;
      allow read: if isAdmin() || isClinicStaff();
    }

    match /clinics/{clinicId} {
      allow read: if true;
      allow create, update: if isAdmin() || belongsToClinic(clinicId);
      allow delete: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if isAdmin() || belongsToClinic(resource.data.clinic_id);
      allow create: if isAdmin() || (belongsToClinic(request.resource.data.clinic_id)
        && request.resource.data.type is string
        && request.resource.data.manufacturer is string
        && request.resource.data.batch is string
        && request.resource.data.quantity is number
        && request.resource.data.expiry is string);
      allow update: if isAdmin() || (belongsToClinic(resource.data.clinic_id)
        && belongsToClinic(request.resource.data.clinic_id)
        && request.resource.data.type is string
        && request.resource.data.manufacturer is string
        && request.resource.data.batch is string
        && request.resource.data.quantity is number
        && request.resource.data.expiry is string);
      allow delete: if isAdmin() || belongsToClinic(resource.data.clinic_id);
    }

    match /appointments/{appointmentId} {
      // createBooking performs the atomic duplicate check with the Admin SDK.
      allow create: if false;
      allow read: if isResident()
        && resource.data.resident_uid == request.auth.uid;
      allow read: if isAdmin() || belongsToClinic(resource.data.clinic_id);
      allow update: if isAdmin()
        || (belongsToClinic(resource.data.clinic_id)
          && request.resource.data.clinic_id == resource.data.clinic_id
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'resident_uid', 'preferred_date', 'preferred_time', 'confirmed_at', 'arrived_at', 'arrived_by', 'arrival_deadline_ms', 'scheduled_at_ms',
            'intake_completed_at', 'patient_record_id', 'course_intake_data'
          ])
          && (resource.data.get('intake_completed_at', null) == null
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'bite_type', 'wound_washed', 'animal_type', 'bite_body_part', 'bite_date', 'patient_age', 'patient_sex'
            ]))
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'pending' && request.resource.data.status == 'declined')
            || (resource.data.status == 'in_progress' && resource.data.get('intake_completed_at', null) != null
              && request.resource.data.status == 'completed')))
        || (isResident()
          && resource.data.resident_uid == request.auth.uid
          && resource.data.status in ['pending', 'confirmed']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancellation_reason is string
          && request.resource.data.cancellation_reason.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellation_reason', 'cancelled_at', 'cancelled_by']));
      allow delete: if isAdmin()
        || belongsToClinic(resource.data.clinic_id)
        || (isResident() && resource.data.resident_uid == request.auth.uid);
    }

    match /patient_records/{recordId} {
      allow read: if isAdmin() || belongsToClinic(resource.data.clinic_id)
        || (isResident() && resource.data.resident_uid == request.auth.uid);
      // Written atomically by manageAppointment. Permanent records are immutable.
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isLoggedIn() && (
          resource.data.recipient_uid == request.auth.uid
          || resource.data.user_id == request.auth.uid
          || belongsToClinic(resource.data.clinic_id)
        ));
      allow create: if isAdmin()
        || isClinicStaff()
        || (isResident() && request.resource.data.type == 'appointment');
      allow update: if isLoggedIn()
        && (resource.data.recipient_uid == request.auth.uid
          || resource.data.user_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /history/{historyId} {
      allow read: if isAdmin() || belongsToClinic(resource.data.clinic_id);
      allow create: if isAdmin() || belongsToClinic(request.resource.data.clinic_id);
      allow update, delete: if isAdmin();
    }

    match /vaccination_records/{recordId} {
      allow read: if isAdmin() 
        || (isResident() && resource.data.resident_uid == request.auth.uid)
        || isClinicStaff();
      allow create: if isAdmin() || (isClinicStaff()
        && request.resource.data.resident_uid is string
        && request.resource.data.dose_number is number
        && request.resource.data.vaccine_name is string
        && request.resource.data.clinic_id is string
        && request.resource.data.clinic_name is string
        && request.resource.data.clinic_location is string
        && request.resource.data.date_given is string
        && belongsToClinic(request.resource.data.clinic_id)
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointment_id)).data.status == 'in_progress'
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.appointment_id)).data.get('intake_completed_at', null) != null
        && request.resource.data.administered_by == request.auth.uid);
      allow update, delete: if false;
    }

    match /vaccination_documents/{documentId} {
      // Supporting vaccination-history records can be reviewed by administrators;
      // clinic staff receive only the document reference attached to their clinic's appointment.
      allow read: if isAdmin() || (isResident() && resource.data.resident_uid == request.auth.uid);
      allow create: if isResident() && request.resource.data.resident_uid == request.auth.uid;
      allow update, delete: if isResident() && resource.data.resident_uid == request.auth.uid;
    }
  }
}
